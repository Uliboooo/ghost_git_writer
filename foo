use std::fs;
use std::path::Path;

fn exist_readme<T: AsRef<Path>>(work_path: T) -> bool {
    fs::read_dir(work_path)
        .ok() // 読み込みに失敗したら None に変換（例: パスが存在しない）
        .into_iter() // Option をイテレータ化（Some(iter) なら 1 要素のイテレータに）
        .flat_map(|iter| iter) // イテレータをそのまま展開
        .filter_map(|entry| entry.ok()) // DirEntry が Err だったものを除外
        .any(|entry| { // 1つでも条件を満たす要素があれば true を返す
            entry
                .path() // エントリのパスを取得
                .file_name() // ファイル名部分だけを取得（Path → OsStr）
                .and_then(|n| n.to_str()) // OsStr を &str に変換（UTF-8でなければ None）
                .map(|s| s.eq_ignore_ascii_case("readme.md")) 
                // 大文字小文字を無視して "readme.md" と一致するか判定
                .unwrap_or(false) // None の場合は false にする
        })
}

use std::fs;
use std::path::{Path, PathBuf};

/// 指定ディレクトリ内に README.md を探す
/// 見つかった場合はそのパスを Some で返し、見つからなければ None
fn find_readme<T: AsRef<Path>>(work_path: T) -> Option<PathBuf> {
    fs::read_dir(work_path).ok()?.filter_map(|entry| entry.ok())
        .find_map(|entry| {
            let path = entry.path(); // ファイルのパスを取得
            path.file_name()         // ファイル名部分を取得
                .and_then(|n| n.to_str()) // UTF-8 に変換
                .filter(|s| s.eq_ignore_ascii_case("readme.md")) // 大文字小文字を無視して比較
                .map(|_| path) // 見つかればパスを返す
        })
}

fn main() {
    if let Some(path) = find_readme(".") {
        println!("Found README: {:?}", path);
    } else {
        println!("README not found");
    }
}

fn find_readme<T: AsRef<Path>>(work_path: T) -> Option<PathBuf> {
    fs::read_dir(work_path).ok()?.filter_map(|entry| entry.ok())
        .find_map(|entry| {
            entry.path()
                .file_name()
                .and_then(|n| n.to_str())
                .filter(|s| s.eq_ignore_ascii_case("readme.md"))
                .map(|_| entry.path()) // ここで再度 path を取得
        })
}
